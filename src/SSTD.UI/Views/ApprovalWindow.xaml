<Window x:Class="SSTD.UI.Views.ApprovalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SSTD — Approval required" Width="640" Height="650" MinWidth="500" MinHeight="430" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Topmost="True" Icon="/Assets/SSTD.png">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="YOUR APPROVAL IS REQUIRED" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="SSTD wants to perform:" Style="{StaticResource H1}" FontSize="25" Margin="0,12,0,18"/><TextBlock x:Name="ActionText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TargetText" Style="{StaticResource MutedText}" Margin="0,8,0,18"/></StackPanel>
    <TextBlock Grid.Row="1" Text="Review the exact action and destination. Approval applies once, not to future tasks." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13"/></ScrollViewer></Border>
    <Grid Grid.Row="3" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="No action occurs until you approve." Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="11"/><Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Padding="23,11"/><Button Grid.Column="2" Content="Approve once" Style="{StaticResource Primary}" Click="Approve_Click" Margin="10,0,0,0" Padding="23,11"/></Grid>
  </Grid>
</Window>
