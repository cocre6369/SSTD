<UserControl x:Class="SSTD.UI.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="A record of real work." Style="{StaticResource H1}"/><TextBlock Text="Requests, action phases, approvals and verification outcomes. No screenshots or clipboard contents." Style="{StaticResource MutedText}" Margin="0,9,0,20"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter requests or statuses" Margin="0,0,12,0"/><Button Grid.Column="1" Content="Refresh" Command="{Binding LoadHistoryCommand}" Margin="0,0,10,0"/><Button Grid.Column="2" Content="Clear history…" Command="{Binding ClearHistoryCommand}"/></Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedTask}" SelectionChanged="Task_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Created, StringFormat=g}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding Request}" Margin="0,9,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,4,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="TASK DETAILS" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding SelectedTask.Request, FallbackValue=Select a task to inspect its timeline}" FontSize="17" FontWeight="SemiBold"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding HistoryEvents}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel><Grid><TextBlock Text="{Binding Phase}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/></Grid><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,7,0,0" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
    </Grid>
  </Grid>
</UserControl>
