<Window x:Class="SSTD.UI.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SSTD.UI.ViewModels" xmlns:views="clr-namespace:SSTD.UI.Views" Title="SSTD — Super Terminal of Deepthinking" Width="1440" Height="940" MinWidth="1050" MinHeight="720" WindowStartupLocation="CenterScreen" Icon="/Assets/SSTD.png">
  <Window.InputBindings><KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding SendCommand}" /><KeyBinding Key="Escape" Command="{Binding StopCommand}" /></Window.InputBindings>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,28,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Image Source="/Assets/SSTD.png" Width="40" Height="40" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="SSTD" FontSize="24" FontWeight="Bold"/><TextBlock Text="LOCAL DESKTOP INTELLIGENCE" FontSize="8" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
          <TextBlock Text="Super Terminal of Deepthinking" Style="{StaticResource MutedText}" FontSize="11" Margin="0,16,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,36,0,0">
          <TextBlock Text="YOUR WORKSPACE" Style="{StaticResource SectionLabel}" Margin="12,0,0,10"/>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Workspace" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,13,0"/><TextBlock Text="Agent workspace"/></StackPanel></Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="History" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Foreground="{StaticResource Muted}" FontSize="18" Margin="0,0,13,0"/><TextBlock Text="Task history"/></StackPanel></Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Foreground="{StaticResource Muted}" FontSize="18" Margin="0,0,12,0"/><TextBlock Text="Settings"/></StackPanel></Button>
          <Button Style="{StaticResource Nav}" Command="{Binding NewConversationCommand}" Margin="0,22,0,0"><TextBlock Text="+   New conversation" Foreground="{StaticResource Accent}"/></Button>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Fill" Value="{StaticResource Green}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style><TextBlock Text="{Binding Status}" FontSize="11"/></StackPanel><TextBlock Text="{Binding ActiveModel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/><TextBlock Text="Inference stays on your machine." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
          <StackPanel Orientation="Horizontal" Margin="8,0,0,0"><TextBlock Text="🛡" FontSize="16" Margin="0,0,9,0"/><StackPanel><TextBlock Text="Safety boundary active" FontSize="11"/><TextBlock Text="Independent of the AI model" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="83"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Page}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="A local mind. A hands-on workspace." Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="MODEL" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Width="196" ItemsSource="{Binding Models}" SelectedItem="{Binding ActiveModel}" IsEnabled="{Binding Connected}" SelectionChanged="Model_SelectionChanged"/><Button Content="↻" ToolTip="Refresh Ollama connection" Command="{Binding RefreshConnectionCommand}" Margin="9,0,0,0" Padding="11,8"/><Button Content="■  STOP" Style="{StaticResource Stop}" Command="{Binding StopCommand}" IsEnabled="{Binding Busy}" Margin="14,0,0,0" Padding="19,10"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid x:Name="WorkspacePage"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
          <Grid Margin="30,24,24,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="#352329" BorderBrush="#65404A" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,16" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Connect your local intelligence" FontWeight="SemiBold"/><TextBlock Text="{Binding Error}" Foreground="#DAB6BF" FontSize="12" Margin="0,7,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Install Ollama" Command="{Binding InstallOllamaCommand}" Padding="12,7"/><Button Content="Connect existing" Command="{Binding ConnectExistingCommand}" Margin="8,0" Padding="12,7"/><Button Content="Retry connection" Command="{Binding RefreshConnectionCommand}" Padding="12,7"/></StackPanel></StackPanel></Border>
            <Grid Grid.Row="1">
              <ScrollViewer x:Name="Welcome" VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,12,4,16">
                <Border Background="{StaticResource AccentDark}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left"><TextBlock Text="PRIVATE BY DESIGN  /  POWERED BY OLLAMA" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                <TextBlock Text="Think it. Do it." Style="{StaticResource H1}" FontSize="38" Margin="0,22,0,10"/>
                <TextBlock Text="Your everyday computer work, in your own words. SSTD observes, plans one step at a time, and checks what changed—without sending your reasoning to the cloud." Style="{StaticResource MutedText}" FontSize="14" MaxWidth="560" HorizontalAlignment="Left" LineHeight="24"/>
                <ItemsControl ItemsSource="{Binding Prompts}" Margin="0,28,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Margin="0,0,10,10" Padding="17,17" Command="{Binding DataContext.UsePromptCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><StackPanel HorizontalAlignment="Left"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Desktop control starts off. Review Settings → Automation before enabling it. Ordinary apps only; system tools and credentials stay out of reach." Style="{StaticResource MutedText}" FontSize="11" Margin="0,13,0,0"/>
              </StackPanel></ScrollViewer>
              <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,6,12"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,20" Padding="17,15" CornerRadius="10" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,9"/><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap" FontSize="13" LineHeight="22" AcceptsReturn="True" IsTabStop="False"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="#302027" CornerRadius="7" Padding="12" Margin="0,8,0,8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NeedsSetup}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12"/></Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="15,13,15,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="PromptInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="140" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="3,4" FontSize="14" ToolTip="Ask SSTD… (Ctrl+Enter to send)" AutomationProperties.Name="Request to SSTD" PreviewKeyDown="PromptInput_PreviewKeyDown"/><Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ctrl + Enter to send  ·  Esc to stop" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Send  ↑" Style="{StaticResource Primary}" Command="{Binding SendCommand}" IsEnabled="{Binding Connected}" Padding="23,9"/></Grid></Grid></Border>
          </Grid>
          <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Background="{StaticResource Sidebar}" Padding="22,27" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="LIVE TASK" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource Card}" Padding="16"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,9,0"/><TextBlock Text="{Binding AutomationState}" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding CurrentTask}" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,10" MaxHeight="85" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TaskSummary}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border></StackPanel>
            <TextBlock Grid.Row="1" Text="ACTIVITY TIMELINE" Style="{StaticResource SectionLabel}" Margin="0,28,0,14"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="•" Foreground="{StaticResource Accent}" FontSize="17"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Phase}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,20,0,0"><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,17"/><TextBlock Text="Observe → Reason → Act → Verify" FontSize="11" Foreground="{StaticResource Accent}"/><TextBlock Text="Only real actions appear here. Stop is always available while a task is running." Style="{StaticResource MutedText}" FontSize="10" Margin="0,9,0,0"/></StackPanel>
          </Grid>
        </Grid>
        <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
        <views:HistoryView x:Name="HistoryPage" Visibility="Collapsed"/>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,0"><Grid><TextBlock Text="SSTD 1.0  ·  WINDOWS x64" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="Local inference  /  Explicit approvals  /  No shell access" HorizontalAlignment="Right" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
