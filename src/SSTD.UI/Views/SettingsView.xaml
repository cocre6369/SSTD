<UserControl x:Class="SSTD.UI.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource Foreground}" FontFamily="{StaticResource UIFont}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24"><StackPanel MaxWidth="960" HorizontalAlignment="Left">
    <TextBlock Text="Make SSTD your own." Style="{StaticResource H1}"/><TextBlock Text="Local intelligence, explicit permissions, and a safety boundary you cannot switch off." Style="{StaticResource MutedText}" Margin="0,9,0,24"/>
    <TabControl x:Name="Tabs">
      <TabItem Header="AI engine"><Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="Ollama connection" Style="{StaticResource H2}"/><TextBlock Text="Only loopback endpoints are accepted. No cloud inference, authentication headers, or redirects." Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
        <TextBlock Text="Endpoint" Margin="0,0,0,7"/><TextBox x:Name="Endpoint" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360"/>
        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,18,0"><TextBlock Text="Installed model" Margin="0,0,0,7"/><ComboBox x:Name="Model" ItemsSource="{Binding Models}"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Temperature (0–2)" Margin="0,0,0,7"/><TextBox x:Name="Temperature"/></StackPanel>
        </Grid>
        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Context size (tokens)" Margin="0,0,0,7"/><TextBox x:Name="ContextSize"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Maximum response (tokens)" Margin="0,0,0,7"/><TextBox x:Name="MaxTokens"/></StackPanel></Grid>
        <Border Background="{StaticResource Background}" CornerRadius="8" Padding="18" Margin="0,25,0,0"><StackPanel><TextBlock Text="Download a model" FontWeight="SemiBold"/><TextBlock Text="Recommended: qwen2.5:7b for tool planning; qwen2.5:3b for low-memory PCs; qwen2.5vl:7b for visual reasoning. Tool reliability varies by model. Downloads require explicit approval." Style="{StaticResource MutedText}" Margin="0,8,0,13"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PullName, UpdateSourceTrigger=PropertyChanged}" MinWidth="200"/><Button Grid.Column="1" Content="Download…" Command="{Binding PullModelCommand}" Margin="9,0,0,0"/><Button Grid.Column="2" Content="Cancel" Command="{Binding CancelPullCommand}" IsEnabled="{Binding Pulling}" Margin="9,0,0,0"/></Grid><ProgressBar Value="{Binding PullProgress}" Height="4" Margin="0,14,0,8" Background="{StaticResource PanelRaised}" Foreground="{StaticResource Accent}" BorderThickness="0" Visibility="{Binding Pulling, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding PullStatus}" Style="{StaticResource MutedText}" FontSize="11"/><Button Content="Browse model recommendations ↗" Command="{Binding OpenOllamaModelsCommand}" HorizontalAlignment="Left" Margin="0,13,0,0"/></StackPanel></Border>
      </StackPanel></Border></TabItem>
      <TabItem Header="Automation"><Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="Your desktop, under control" Style="{StaticResource H2}"/><TextBlock Text="SSTD uses real UI Automation and input. It does not claim universal compatibility with inaccessible apps or games." Style="{StaticResource MutedText}" Margin="0,8,0,17"/>
        <CheckBox x:Name="DesktopControl" Content="Enable desktop control" FontWeight="SemiBold"/>
        <TextBlock Text="Start with Notepad or another ordinary application. SSTD will inspect before it acts. External commitments still require a separate approval." Style="{StaticResource MutedText}" Margin="24,0,0,15"/>
        <CheckBox x:Name="UiAutomation" Content="Use Windows UI Automation (preferred)"/>
        <CheckBox x:Name="VisualRecognition" Content="Enable on-demand Windows OCR when UI information is insufficient"/>
        <CheckBox x:Name="SendImages" Content="Allow relevant screenshots to be sent to the selected local vision model"/>
        <TextBlock Text="Screenshots are off by default. OCR runs locally. Images are never saved to task history. Password contexts are rejected before capture." Style="{StaticResource MutedText}" Margin="24,0,0,14"/>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Task timeout (seconds)" Margin="0,0,0,7"/><TextBox x:Name="Timeout"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Maximum action steps" Margin="0,0,0,7"/><TextBox x:Name="MaxSteps"/></StackPanel></Grid>
        <CheckBox x:Name="ShowProgress" Content="Show live task progress" Margin="0,20,0,8"/>
        <Border Background="{StaticResource AccentDark}" CornerRadius="8" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="Always-on protection" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="External sends, posts, submissions, uploads and purchases require approval. New documents require approval. Terminals, system administration, credentials, destructive file actions, and arbitrary code execution are always blocked. These protections have no settings override." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
      </StackPanel></Border></TabItem>
      <TabItem Header="Interface"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="A quieter place to work" Style="{StaticResource H2}"/><TextBlock Text="Appearance and comfort preferences." Style="{StaticResource MutedText}" Margin="0,8,0,20"/><TextBlock Text="Theme" Margin="0,0,0,8"/><ComboBox x:Name="Theme" Width="250" HorizontalAlignment="Left"><ComboBoxItem Content="Charcoal"/><ComboBoxItem Content="Midnight"/></ComboBox><CheckBox x:Name="Animations" Content="Enable interface animations"/><CheckBox x:Name="Notifications" Content="Show task completion notifications"/><CheckBox x:Name="Sounds" Content="Play a sound when a task finishes"/><CheckBox x:Name="Tray" Content="Keep SSTD in the system tray when closing the window"/><TextBlock Text="With tray mode enabled, use the tray icon's Exit command to quit. Otherwise closing the window stops automation and exits." Style="{StaticResource MutedText}" Margin="24,0,0,0"/></StackPanel></Border></TabItem>
      <TabItem Header="Privacy"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local by default" Style="{StaticResource H2}"/><TextBlock Text="Ollama performs inference locally. Websites and apps you ask SSTD to use still have their own network behavior and privacy policies." Style="{StaticResource MutedText}" Margin="0,8,0,18"/><CheckBox x:Name="ConversationHistory" Content="Remember conversation history on this device"/><CheckBox x:Name="TaskHistory" Content="Remember task outcomes and action phases"/><TextBlock Text="History excludes clipboard contents, screenshots, passwords and full typed content. Secret-like material is redacted. History is local SQLite, not operating-system encryption; protect your Windows account." Style="{StaticResource MutedText}" Margin="24,0,0,18"/><StackPanel Orientation="Horizontal"><Button Content="Clear task history" Command="{Binding ClearHistoryCommand}"/><Button Content="Clear conversations + history…" Command="{Binding ClearAllCommand}" Margin="10,0,0,0"/><Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="10,0,0,0"/></StackPanel><TextBlock Text="Clearing SSTD data does not uninstall Ollama, delete its models, or alter other applications." Style="{StaticResource MutedText}" Margin="0,18,0,0"/></StackPanel></Border></TabItem>
    </TabControl>
    <Grid Margin="0,18,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Error}" Style="{StaticResource MutedText}" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Grid.Column="1" Content="Save settings" Style="{StaticResource Primary}" Click="Save_Click" Padding="25,11"/></Grid>
  </StackPanel></ScrollViewer>
</UserControl>
